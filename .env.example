# Copy to .env. This file is read by the local server only. Never put a real key in browser settings.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=
MODEL_PROVIDER=OpenAI-compatible
# Conservative character-based context budget; includes output reserve. Not exact token accounting.
MODEL_CONTEXT_BUDGET=24000
MODEL_OUTPUT_BUDGET=2400
MODEL_TIMEOUT_MS=60000
# story: prose first, then extract and validate records. planned/direct are legacy comparison modes.
# All stages share MODEL_TIMEOUT_MS. No silent fallback.
MODEL_NARRATIVE_ENGINE=story
PORT=4173

# Opt in to the generative UI migration (artifact history, React workbench,
# semantic display routing). Keep false until the broader acceptance gates pass.
GENERATIVE_UI_ENABLED=false

# Or reuse a locally logged-in Codex CLI (no API key):
# MODEL_PROVIDER=codex
# CODEX_CLI_PATH=C:/path/to/codex.exe
# CODEX_AUTH_HOME=C:/Users/your-name/.codex
# CODEX_PROXY=http://127.0.0.1:10808
# MODEL_NAME=your-model-id
# MODEL_TIMEOUT_MS=180000
