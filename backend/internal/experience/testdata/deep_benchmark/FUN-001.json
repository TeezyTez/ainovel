  "steps": [
    {
      "id": "01",
      "mode": "player",
      "input": "我先看柜门和留下的机械记录，不指认任何人。"
    },
    {
      "id": "02",
      "mode": "player",
      "input": "问值班主管：还有别人、备用片或远程开柜的可能吗？记录时钟可靠吗？"
    },
    {
      "id": "03",
      "mode": "player",
      "input": "暂时把三个人都保留为嫌疑人，分别问他们20:40到20:46在哪里。"
    },
    {
      "id": "04",
      "mode": "player",
      "input": "先调灯塔的完整连续影像，并核实到柜室的最快距离。"
    },
    {
      "id": "05",
      "mode": "player",
      "input": "如果岑特别不讨人喜欢，我是否仍有证据指控他？我只据现有证据判断。"
    },
    {
      "id": "06",
      "mode": "player",
      "input": "再查外码头的连续影像与最短路程。"
    },
    {
      "id": "07",
      "mode": "player",
      "input": "调柜旁走廊记录，核对余是否真的一直待在办公室。"
    },
    {
      "id": "08",
      "mode": "player",
      "input": "只向余展示走廊记录，请他解释；先不告诉他我已查过哪两个人。"
    },
    {
      "id": "09",
      "mode": "player",
      "input": "向主管呈现三人的时间线，申请查验余的文件筒。"
    },
    {
      "id": "10",
      "mode": "player",
      "input": "按主管允许的方式查验文件筒。",
      "requires_steps": [
        "09"
      ],
      "evidence_gate": "search-approval"
    },
    {
      "id": "11",
      "mode": "player",
      "input": "把已核实的事实写成结论，并把尚不能证明的动机另列。",
      "requires_steps": [
        "10"
      ]
    },
    {
      "id": "12",
      "mode": "player",
      "input": "我建议先归还铜印，另将救济船问题提交紧急审议，而不擅自赦免。",
      "requires_steps": [
        "10"
      ]
    },
    {
      "id": "13",
      "mode": "player",
      "input": "隔天再次查询铜印保管和救济船处理情况。",
      "requires_steps": [
        "10"
      ]
    }
  ],
