  "steps": [
    {
      "id": "S01",
      "mode": "act",
      "input": "我向各自负责人询问任务需要，分别记录。"
    },
    {
      "id": "S02",
      "mode": "act",
      "input": "问甄洛哪些步骤必须先做，哪些能分开。"
    },
    {
      "id": "S03",
      "mode": "act",
      "input": "问裴青窗板的问题与可行安排。"
    },
    {
      "id": "S04",
      "mode": "act",
      "input": "问晏泊能做哪些、愿意接哪些，不替他报名。"
    },
    {
      "id": "S05",
      "mode": "act",
      "input": "向明阑确认我能怎样提出方案。"
    },
    {
      "id": "S06",
      "mode": "act",
      "input": "我用现在确实掌握的信息提出一个分配办法，请他们各自表态。"
    },
    {
      "id": "S07",
      "mode": "continue",
      "input": "继续讨论，人物可以彼此回应和提出自己的方案。"
    },
    {
      "id": "S08",
      "mode": "act",
      "input": "我听到新的可核实信息后调整自己的提议；没新证据就不编数字。"
    },
    {
      "id": "S09",
      "mode": "act",
      "input": "我说希望大家照我的方案做，但是否有权通过仍按实际程序。"
    },
    {
      "id": "S10",
      "mode": "continue",
      "input": "写实际表决或暂未表决的阶段结果。"
    },
    {
      "id": "S11",
      "mode": "act",
      "input": "我只承担自己明确同意且被接纳的那部分工作。"
    },
    {
      "id": "S12",
      "mode": "continue",
      "input": "几天后写正在执行的工作与真实成本。"
    },
    {
      "id": "S13",
      "mode": "act",
      "input": "我请晏泊评价实际分工是否和当初约定一致。"
    },
    {
      "id": "S14",
      "mode": "continue",
      "input": "让这一轮协作收束，保留未解决的问题但不自动制造新灾难。"
    }
  ],
